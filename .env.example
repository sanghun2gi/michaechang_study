# ── AI (서버 사이드 전용 — 절대 NEXT_PUBLIC_ 접두사 금지) ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# ── 데이터베이스 (Prisma). 미설정 시 인메모리 원장·데모 모드로 동작 ──
DATABASE_URL="postgresql://user:password@localhost:5432/patent_dashboard?schema=public"

# ── 선행기술 검색 (3차 스프린트, 선택) ──
# KIPRIS Plus API 키: https://plus.kipris.or.kr/
KIPRIS_API_KEY=

# SerpAPI 키 (Google Patents 검색): https://serpapi.com/
# 미설정 시 데모 결과 반환
SERPAPI_KEY=
