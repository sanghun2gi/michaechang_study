// AI 특허출원 대시보드 — Prisma 스키마 v3
// 2차: Evidence, ClaimLadder, OASimulation, ReviewApproval 영속화 추가
// 3차: EffectData(효과데이터), EligibilityGate(SW·AI 적격성) 추가

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  attorney
  member
}

enum SecurityLevel {
  S
  A
  B
  C
}

enum HallucinationTag {
  GREEN
  YELLOW
  RED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// 조직 = 테넌트 격리 단위
model Organization {
  id            String        @id @default(cuid())
  name          String
  securityLevel SecurityLevel @default(C)
  createdAt     DateTime      @default(now())
  users         User[]
  projects      Project[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  role           Role         @default(owner)
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())
}

model Project {
  id             String        @id @default(cuid())
  name           String
  securityLevel  SecurityLevel @default(C)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  inventions     Invention[]
  createdAt      DateTime      @default(now())
}

// STEP 1: 발명 입력
model Invention {
  id             String          @id @default(cuid())
  title          String
  field          String
  problem        String
  solution       String
  effect         String
  keyFeatures    String
  project        Project?        @relation(fields: [projectId], references: [id])
  projectId      String?
  structureCard  StructureCard?
  specification  Specification?
  evidence       Evidence[]
  claimLadder    ClaimLadder?
  oaSimulation   OASimulation?
  reviewApproval ReviewApproval?
  effectData     EffectData?
  eligibility    EligibilityGate?
  createdAt      DateTime        @default(now())
}

// STEP 3: 발명 구조화 카드
model StructureCard {
  id          String    @id @default(cuid())
  invention   Invention @relation(fields: [inventionId], references: [id])
  inventionId String    @unique
  content     String    // JSON: { components, problemSolutionMap, noveltyPoints }
  createdAt   DateTime  @default(now())
}

// STEP 18/19: 명세서/청구항 초안 + 할루시네이션 검증
model Specification {
  id           String           @id @default(cuid())
  invention    Invention        @relation(fields: [inventionId], references: [id])
  inventionId  String           @unique
  background   String
  summary      String
  detailed     String
  claims       String
  verification String?          // JSON: VerificationItem[]
  overallTag   HallucinationTag @default(YELLOW)
  createdAt    DateTime         @default(now())
}

// STEP 6: 선행기술 근거 (Evidence DB) — Invention당 N건
model Evidence {
  id          String    @id @default(cuid())
  invention   Invention @relation(fields: [inventionId], references: [id])
  inventionId String
  title       String
  source      String    // 특허번호/논문/URL
  pubDate     String    // 공개일 (자유 텍스트)
  summary     String
  origin      String    @default("manual") // "manual" | "kipris" | "google"
  createdAt   DateTime  @default(now())
}

// STEP 14/15: Claim Ladder + Fallback Elements
model ClaimLadder {
  id          String    @id @default(cuid())
  invention   Invention @relation(fields: [inventionId], references: [id])
  inventionId String    @unique
  rungs       String    // JSON: ClaimRung[]
  fallbacks   String    // JSON: FallbackElement[]
  createdAt   DateTime  @default(now())
}

// STEP 21: 가상 거절이유 OA
model OASimulation {
  id          String           @id @default(cuid())
  invention   Invention        @relation(fields: [inventionId], references: [id])
  inventionId String           @unique
  rejections  String           // JSON: Rejection[]
  overallRisk HallucinationTag @default(YELLOW)
  createdAt   DateTime         @default(now())
}

// STEP 24/24B: 전문가 리뷰·승인 게이트
model ReviewApproval {
  id          String         @id @default(cuid())
  invention   Invention      @relation(fields: [inventionId], references: [id])
  inventionId String         @unique
  status      ApprovalStatus @default(PENDING)
  reviewer    String         @default("")
  comment     String         @default("")
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
}

// STEP 0B: Provenance Ledger
model LedgerRecord {
  id             String   @id @default(cuid())
  step           String
  action         String
  model          String
  inputSummary   String
  outputSummary  String
  organizationId String?
  inventionId    String?
  createdAt      DateTime @default(now())
}

// ── 3차 스프린트 ──────────────────────────────────────────────

// 효과데이터 프로토콜 — 발명 효과의 정량 근거
model EffectData {
  id             String    @id @default(cuid())
  invention      Invention @relation(fields: [inventionId], references: [id])
  inventionId    String    @unique
  // JSON: EffectEntry[] — 각 효과별 측정값·비교대상·출처
  entries        String
  overallQuality String    @default("UNVERIFIED") // VERIFIED | PARTIAL | UNVERIFIED
  createdAt      DateTime  @default(now())
}

// SW·AI 적격성 Gate — 소프트웨어/AI 발명 특허적격성 체크리스트
model EligibilityGate {
  id          String    @id @default(cuid())
  invention   Invention @relation(fields: [inventionId], references: [id])
  inventionId String    @unique
  // JSON: EligibilityCheckItem[]
  checks      String
  verdict     String    @default("UNDETERMINED") // ELIGIBLE | BORDERLINE | INELIGIBLE
  createdAt   DateTime  @default(now())
}
